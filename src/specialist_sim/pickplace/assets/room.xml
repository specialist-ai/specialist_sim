<mujoco model="specialist_room">
  <compiler angle="radian"/>

  <option impratio="10" integrator="implicitfast" cone="elliptic"/>

  <visual>
    <headlight diffuse="0 0 0"/>
    <map znear="0.002" zfar="7"/>
  </visual>

  <default>
    <default class="decor">
      <geom type="box" contype="0" conaffinity="0" group="1" mass="0"/>
      <default class="solid">
        <geom contype="1" conaffinity="1" friction="0.26" solref="0.005"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- What a ray that leaves the room reads. -->
    <texture name="background" type="skybox" builtin="flat" width="16" height="16"
             rgb1="0.16 0.16 0.17" rgb2="0.16 0.16 0.17"/>
    <texture name="floor_texture" type="2d" file="floor_texture.png"/>
    <texture name="wall_texture" type="2d" file="wall_texture.png"/>
    <texture name="table_texture" type="2d" file="table_texture.png"/>
    <material name="floor_material" texture="floor_texture" texrepeat="3 3"/>
    <material name="wall_material" texture="wall_texture" texrepeat="4 3"/>
    <material name="table_material" texture="table_texture" texrepeat="2 4"/>
  </asset>

  <!-- The room frame is the capture's: the tag stands' midpoint is the origin,
       +X points toward the table, +Y toward the left wall, +Z up, and the tag
       centers stand 1.05 m above the floor. The 1.20 x 0.60 m tabletop starts
       0.40 m past the tag line, 0.20 m off the two walls bounding the work
       area, with the tape target and the cube on it; only those two collide.
       A tag body's origin is the center of its face, +X image-right, +Y
       image-up, +Z out of the face, both faces turned 45 degrees toward +X
       and toward each other. -->
